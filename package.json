{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content": "velite build --strict --clean",
    "dev": "pnpm content && next dev",
    "build": "pnpm content && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm content && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "gsap": "3.15.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "velite": "0.4.0",
    "vitest": "5.0.5"
